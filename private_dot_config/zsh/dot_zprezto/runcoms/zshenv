# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi


### zoxide
[[ -d $XDG_DATA_HOME ]] && export _ZO_DATA_DIR="$XDG_DATA_HOME/zoxide"


### volta
[[ -d $XDG_DATA_HOME ]] && export VOLTA_HOME="$XDG_DATA_HOME/volta"


### homebrew
# Set Brewfile location.
[[ -d $XDG_CONFIG_HOME ]] && export HOMEBREW_BUNDLE_FILE="$XDG_CONFIG_HOME/homebrew/Brewfile"


# Disable VSCode integration.
export HOMEBREW_BUNDLE_DUMP_NO_VSCODE="true"


### Anthropic
# Claude.ai long lived OAuth token for claude code cli running in container
export CLAUDE_CODE_OAUTH_TOKEN=$(security find-generic-password -s 'Claude Long Lived OAuth Token' -w)

echo "$(date '+%T') parent=$(ps -o args= -p $PPID) cmd=${ZSH_EXECUTION_STRING:-<interactive>}" >> /tmp/keychain-reads.log
# 1Password service token for Dev service account
export OP_SERVICE_ACCOUNT_TOKEN=$(security find-generic-password -s '1Password Service Account - Dev' -w)

